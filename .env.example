# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_TRANSACTIONS=payments.transactions
KAFKA_TOPIC_DLQ=payments.dlq

# Storage paths (local disk, mounted into Docker later)
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold
CHECKPOINT_PATH=./checkpoints

# Environment
ENV=local
LOG_LEVEL=INFO

PRODUCER_MAX_EVENTS=900
PRODUCER_MIN_DELAY_MS=200
PRODUCER_MAX_DELAY_MS=2000

FAULT_DUPLICATE_RATE=0.05
FAULT_LATE_RATE=0.05
FAULT_CORRUPT_RATE=0.03